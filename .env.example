# Application Environment
APP_ENV=development
APP_NAME=Salon SaaS Platform

# Database Configuration
DATABASE_URL=postgresql://salon_user:salon_password_dev@localhost:5432/salon_saas_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Authentication (placeholder for Phase 1+)
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Object Storage (placeholder for Phase 1+)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=salon-saas-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Logging
LOG_LEVEL=INFO

