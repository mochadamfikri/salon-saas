# Application
APP_ENV=development
APP_NAME=Salon SaaS Platform
LOG_LEVEL=INFO

# PostgreSQL development service (Docker Compose)
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=salon_password_dev
POSTGRES_DB=salon_saas_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://salon_user:salon_password_dev@localhost:5432/salon_saas_dev

# Redis development service (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Application URLs
# API_BASE_URL is consumed by both API clients and the server-side Next.js health check.
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Future authentication placeholder — no authentication implementation in Phase 0
JWT_SECRET=replace_with_a_secure_value_in_non-development_environments

# Future object storage placeholder — no object-storage implementation in Phase 0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=salon-saas-dev
OBJECT_STORAGE_ACCESS_KEY=replace_me
OBJECT_STORAGE_SECRET_KEY=replace_me
